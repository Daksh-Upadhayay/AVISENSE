# Copy to backend/.env and fill in.
# The API only needs the public anon key: it forwards each user's own access
# token to Supabase, so row-level security applies. Do NOT use the service-role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Comma-separated list of frontend origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5180
LOG_LEVEL=INFO
